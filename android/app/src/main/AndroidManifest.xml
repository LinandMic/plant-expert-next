<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Android App Links: only https://almeo.app/reset-password
                 (exact path) opens the app. Must stay in sync with
                 SUPPORTED_NATIVE_ROUTES in lib/nativeDeepLink.js and be
                 verified by https://almeo.app/.well-known/assetlinks.json. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="almeo.app"
                    android:path="/reset-password" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Required by @capacitor/camera's takePhoto(). chooseFromGallery()
         needs no declared permission: it uses the system photo picker /
         GET_CONTENT intent (see the plugin's own manifest <queries>), which
         grants file access without READ_EXTERNAL_STORAGE. We never save to
         the gallery, so WRITE_EXTERNAL_STORAGE isn't needed either. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Camera hardware is optional: the gallery-picker path still works
         without it, so the app must not be excluded from camera-less
         devices on the Play Store. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
</manifest>
