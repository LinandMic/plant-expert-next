# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# plant benchmark tool (scripts/plant-benchmark): keep raw provider dumps
# and generated outputs out of the repo, but allow the checked-in example
# env file despite the .env* rule above
/scripts/plant-benchmark/raw/
/scripts/plant-benchmark/output/
!/scripts/plant-benchmark/.env.benchmark.example

# plant ingestion dry-run tool (scripts/plant-ingestion): dry-run JSON
# bundles and raw provider dumps are local audit artifacts only, never
# committed. The checked-in example env file is allowed despite the .env*
# rule above.
/scripts/plant-ingestion/output/
!/scripts/plant-ingestion/.env.ingestion.example
