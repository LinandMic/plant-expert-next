# Copy this file to .env.benchmark (same directory) and fill in real values.
# .env.benchmark is already covered by the repo's existing `.env*` gitignore
# rule — it will never be committed. Never put real keys in this .example
# file, never commit real keys anywhere.

PERENUAL_API_KEY=
TREFLE_API_KEY=

# Not a secret — which Perenual subscription tier PERENUAL_API_KEY belongs
# to. Documented values: personal | premium | supreme (Perenual's own
# published tier names; add more here as Perenual documents them).
#
# Why this matters: on the Personal tier, Perenual documents access as
# limited to a subset of their catalog (observed: "Species Data 1-3000").
# Under that tier, an empty search result (HTTP 200, data=[]) does NOT
# prove the plant is absent from Perenual's database — it may simply be
# outside the visible range for this key. Setting this to `personal` makes
# the benchmark report that case as `unresolved_under_plan` instead of a
# scientifically-asserted `not_found` (see providers/perenual.js).
#
# Leave empty/unset if the tier is unknown or gives full catalog access —
# the benchmark never fabricates `unresolved_under_plan` without this being
# explicitly set to a known limited tier.
PERENUAL_ACCESS_TIER=
