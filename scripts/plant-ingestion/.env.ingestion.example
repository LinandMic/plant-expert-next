# Copy this file to .env.ingestion (same directory) and fill in real values.
# .env.ingestion is already covered by the repo's existing `.env*` gitignore
# rule — it will never be committed. Never put real keys in this .example
# file, never commit real keys anywhere.
#
# Layer C (scripts/plant-ingestion/src/apply/*, applyCli.js, verifyCli.js)
# only. These are server/local-only secrets — never prefix them
# NEXT_PUBLIC_, never import supabaseConfig.js/supabaseAdminClient.js from
# anything reachable from the Next.js browser bundle.

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
